{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug-macos",
      "displayName": "Debug (macOS, Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    },
    {
      "name": "release-macos",
      "displayName": "Release (macOS, Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-macos",
      "configurePreset": "debug-macos",
      "configuration": "Debug"
    },
    {
      "name": "release-macos",
      "configurePreset": "release-macos",
      "configuration": "Release"
    }
  ]
}
